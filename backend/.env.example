# Application
APP_NAME=JobMatcher
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# API
API_V1_PREFIX=/api
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://jobmatcher:password@localhost:5432/jobmatcher
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# AWS S3 (for resume storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=jobmatcher-resumes
AWS_REGION=us-east-1

# OpenAI (for cover letter generation)
OPENAI_API_KEY=sk-your-openai-api-key

# Scraping
SCRAPING_ENABLED=True
SCRAPING_INTERVAL_HOURS=12
SCRAPING_RATE_LIMIT=2  # requests per second
SCRAPING_USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
